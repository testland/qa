{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "tap",
  "tap": { "testFiles": ["src/**/*.test.js"] },
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "reporters": ["progress", "clear-text"],
  "mutate": ["src/**/*.js"],
  "thresholds": { "high": 80, "low": 60, "break": 60 }
}
