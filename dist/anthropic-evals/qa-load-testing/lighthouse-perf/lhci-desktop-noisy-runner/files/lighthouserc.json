{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:8080/admin/reports"
      ],
      "numberOfRuns": 1,
      "settings": {
        "formFactor": "desktop",
        "throttlingMethod": "devtools"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ]
      }
    }
  }
}
