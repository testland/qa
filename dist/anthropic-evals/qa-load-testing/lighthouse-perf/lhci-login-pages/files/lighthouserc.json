{
  "ci": {
    "collect": {
      "url": [
        "https://staging.example.com/dashboard",
        "https://staging.example.com/reports"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
