# Shell scripts must use LF line endings so they run correctly on Linux CI
# runners regardless of the contributor's local autocrlf setting.
*.sh        text eol=lf
*.bash      text eol=lf

# JSON, YAML, and Markdown can stay platform-default text but normalize on commit.
*.json      text
*.yml       text
*.yaml      text
*.md        text

# Eval scenarios and the artifacts compiled from them are compared byte-for-byte
# by `npm run evals:check`, and their fixtures are hashed by the run harness.
# CRLF conversion on a Windows checkout would fail both, so pin them to LF.
plugins/**/evals/**  text eol=lf
dist/anthropic-evals/**  text eol=lf
